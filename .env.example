# Variables que necesita la app. Copia este archivo como .env.local (local)
# o ponlas en Vercel → Settings → Environment Variables (producción).
# Están en Supabase → Project Settings → API Keys.

# Dirección del proyecto de Supabase (p. ej. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (empieza por sb_publishable_). La usan el inicio de sesión y la comprobación de sesión de cada página (src/proxy.ts).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave SECRETA (empieza por sb_secret_). Da acceso total: nunca la compartas ni la subas a GitHub.
SUPABASE_SECRET_KEY=

# Clave maestra con la que se cifran el token de GHL y las API keys de Fathom en la base de datos.
# Se genera una vez con:  openssl rand -base64 32
# Guárdala también en un sitio seguro (gestor de contraseñas): si se pierde o se cambia,
# hay que volver a pegar el token de GHL y las claves de Fathom en la app.
CLAVE_CIFRADO=

# --- Emails (bloque 6): avisos de reportes por email y enlaces mágicos, con Resend ---
# Clave de Resend (resend.com → API Keys, permiso «Sending access», dominio eternity.llc). Sin ella no se mandan emails
# (el resto de la app funciona; los avisos siguen yendo al webhook de GHL).
RESEND_API_KEY=
# Dirección pública de la app, para los enlaces de los emails (en producción: https://dashboard.eternity.llc).
APP_URL=
# Remitente (opcional). Por defecto: Eternity <no-reply@eternity.llc>
EMAIL_REMITENTE=
# --- v2 (opcionales: sin ellas la app funciona, pero no analiza ni transcribe) ---

# Clave de la API de Claude (consola de Anthropic → API Keys). Analiza llamadas, coach, scoring. Modelo: Sonnet 5.5.
ANTHROPIC_API_KEY=

# Clave de Deepgram (su consola → API Keys). Pasa a texto las llamadas de GHL que GHL no haya transcrito.
DEEPGRAM_API_KEY=
